+  int inflictor, source; // thing types (-1: none): what hit her, whose it was
+  int self;              // her own (a rocket of hers, a barrel she set off)
+  int cause;             // 0 a thing, 1 a crusher, 2 the floor, 3 something else
+  int source_id;         // whose it was: that thing's evil_id (0: no one's); for measuring, not hers to know
+  int side;              // where the status bar's face looks for it: -1 left, 0 straight at it, 1 right; 2: nowhere (no one's)
