diff --git a/prboom2/src/s_sound.c b/prboom2/src/s_sound.c
index a12136e..2351f71 100644
--- a/prboom2/src/s_sound.c
+++ b/prboom2/src/s_sound.c
@@ -320,6 +320,76 @@ void S_ResetAdjustments(void) {
   adjust_volume = 0;
 }
 
+// Evil (evil-doom): a sound noted as the listener would hear it, by vanilla's rule (heard within
+// 1200 whatever's between, full within 160; its side by the sine of its bearing), whether
+// sound's on or not and whether a channel's found for it or not.
+evil_sound_t evil_sounds[EVIL_SOUNDS];
+int evil_sound_count;
+
+static void Evil_NoteSound(mobj_t *origin, mobj_t *listener, int sfx_id)
+{
+  evil_sound_t *e;
+  int volume = 127, separation = 128, own = !origin || origin == listener;
+  sfx_id &= ~PICKUP_SOUND;
+  if (sfx_id == sfx_None || !listener)
+    return;
+  if (!own)
+  {
+    angle_t angle;
+    fixed_t dist = P_AproxDistance(D_abs(listener->x - origin->x), D_abs(listener->y - origin->y)) >> FRACBITS;
+    if (dist >= 1200)
+      return;
+    if (dist >= 160)
+      volume = 127 * (1200 - dist) / (1200 - 160);
+    if (volume < 1)
+      volume = 1;
+    if (origin->x != listener->x || origin->y != listener->y)
+    {
+      angle = R_PointToAngle2(listener->x, listener->y, origin->x, origin->y);
+      if (angle <= listener->angle)
+        angle += 0xffffffff;
+      angle -= listener->angle;
+      angle >>= ANGLETOFINESHIFT;
+      separation = 128 - (FixedMul(S_STEREO_SWING, finesine[angle]) >> FRACBITS);
+    }
+  }
+  e = &evil_sounds[evil_sound_count % EVIL_SOUNDS];
+  e->tic = gametic;
+  e->sfx = sfx_id;
+  e->own = own;
+  e->chasing = 0;
+  if (origin && origin->thinker.function == P_MobjThinker)
+  {
+    e->origin_id = origin->evil_id;
+    e->origin_type = (int)origin->type;
+    // (is the state it's in one of its chase's: the loop from its see state)
+    if (origin->info && origin->info->seestate)
+    {
+      const state_t *first = &states[origin->info->seestate], *st = first;
+      int n = 0;
+      do
+      {
+        if (st == origin->state)
+        {
+          e->chasing = 1;
+          break;
+        }
+        st = &states[st->nextstate];
+      } while (++n < 64 && st != first);
+    }
+  }
+  else
+  {
+    e->origin_id = 0;
+    e->origin_type = -1;
+  }
+  e->volume = volume;
+  e->separation = separation;
+  e->x = origin ? origin->x >> FRACBITS : listener->x >> FRACBITS;
+  e->y = origin ? origin->y >> FRACBITS : listener->y >> FRACBITS;
+  evil_sound_count++;
+}
+
 void S_StartSoundAtVolume(void *origin_p, int sfx_id, int volume, dboolean important, int loop_timeout)
 {
   int cnum;
@@ -333,6 +403,8 @@ void S_StartSoundAtVolume(void *origin_p, int sfx_id, int volume, dboolean impor
   origin = (mobj_t *) origin_p;
   listener = GetSoundListener();
 
+  Evil_NoteSound(origin, listener, sfx_id);  // Evil (evil-doom)
+
   //jff 1/22/98 return if sound is not enabled
   if (nosfxparm)
     return;
