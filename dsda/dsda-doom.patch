--- a/prboom2/src/SDL/i_system.c
+++ b/prboom2/src/SDL/i_system.c
@@ -155,8 +155,14 @@ fixed_t I_GetTimeFrac (void)
  *
  * CPhipps - extracted from G_ReloadDefaults because it is O/S based
  */
+// Evil (evil-doom): when set, this seed instead of the clock (the same game every run)
+int evil_fixed_seed;
+unsigned long evil_seed_value;
+
 unsigned long I_GetRandomTimeSeed(void)
 {
+  if (evil_fixed_seed)
+    return evil_seed_value;
   return (unsigned long)time(NULL);
 }
 
