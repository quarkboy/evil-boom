+// Evil (evil-doom): the hits on the player, the last EVIL_HITS of them (evil_hit_count in all)
+typedef struct
+{
+  int health, armor;     // what it took
+  int inflictor, source; // thing types (-1: none): what hit her, whose it was
+  int self;              // her own (a rocket of hers, a barrel she set off)
+  int cause;             // 0 a thing, 1 a crusher, 2 the floor, 3 something else
+} evil_hit_t;
+#define EVIL_HITS 64
+extern evil_hit_t evil_hits[EVIL_HITS];
+extern int evil_hit_count;
