--- a/prboom2/src/dsda/messenger.c
+++ b/prboom2/src/dsda/messenger.c
@@ -106,7 +106,16 @@ void dsda_AddAlert(const char* str) {
   dsda_QueueMessage(str, message_alert);
 }
 
+// Evil (evil-doom): the last message the game gave the player and when, shown or not
+// ("You need a blue key to open this door": a player knows what she pressed was locked)
+const char* evil_message;
+int evil_message_tic = -1;
+
 void dsda_AddPlayerMessage(const char* str, player_t* player) {
+  if (player == &players[consoleplayer]) {
+    evil_message = str;
+    evil_message_tic = gametic;
+  }
   if (dsda_ShowMessages() && player == &players[displayplayer])
     dsda_QueueMessage(str, message_normal);
 }
