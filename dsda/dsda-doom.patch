+
+// Evil (evil-boom): the status bar drawn for another player's view (a co-op watch's views
+// of each player): its numbers, arms and keys theirs, its face straight ahead as hurt as they
+// are, god or dead (the face's moods are worked out a tic at a time, ST_Ticker, for the
+// player the bar was started for: consoleplayer). ST_EvilView(consoleplayer) puts it back,
+// the face as it was.
+void ST_EvilView(int player)
+{
+  static int kept_face = -1;
+  static int no_ammo = 1994;  // (as ST_updateWidgets has it: "n/a")
+  int i;
+  if (raven || player < 0 || player >= MAX_MAXPLAYERS || plyr == &players[player])
+    return;
+  if (plyr == &players[consoleplayer])
+    kept_face = st_faceindex;
+  plyr = &players[player];
+  ST_createWidgets();
+  w_ready.num = weaponinfo[plyr->readyweapon].ammo == am_noammo ? &no_ammo
+              : &plyr->ammo[weaponinfo[plyr->readyweapon].ammo];
+  for (i = 0; i < 3; i++)
+  {
+    keyboxes[i] = plyr->cards[i] ? i : -1;
+    if (plyr->cards[i+3])
+      keyboxes[i] = keyboxes[i]==-1 || sts_traditional_keys ? i+3 : i+6;
+  }
+  if (player == consoleplayer)
+  {
+    if (kept_face >= 0)
+      st_faceindex = kept_face;
+  }
+  else if (plyr->health <= 0)
+    st_faceindex = ST_DEADFACE;
+  else if ((plyr->cheats & CF_GODMODE) || plyr->powers[pw_invulnerability])
+    st_faceindex = ST_GODFACE;
+  else
+    st_faceindex = ST_calcPainOffset() + 1;
+}
