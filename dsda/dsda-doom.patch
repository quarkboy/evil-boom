+// Evil (evil-boom): a sound noted as the listener would hear it, by vanilla's rule (heard within
+// 1200 whatever's between, full within 160; its side by the sine of its bearing), whether
+// sound's on or not and whether a channel's found for it or not. And as each other player in
+// the game would hear it from where they are (a co-op game): a sound with no origin (her
+// pickups) only by the listener, as the game plays it only for the player it's showing.
+evil_sound_t evil_sounds[EVIL_SOUNDS];
+int evil_sound_count;
+
+/* How `listener` hears a sound from `origin`: 0, not at all. */
+static int Evil_Hear(mobj_t *origin, mobj_t *listener, int *volume, int *separation, int *own)
+{
+  *volume = 127;
+  *separation = 128;
+  *own = !origin || origin == listener;
+  if (!listener)
+    return 0;
+  if (!*own)
+  {
+    angle_t angle;
+    fixed_t dist = P_AproxDistance(D_abs(listener->x - origin->x), D_abs(listener->y - origin->y)) >> FRACBITS;
+    if (dist >= 1200)
+      return 0;
+    if (dist >= 160)
+      *volume = 127 * (1200 - dist) / (1200 - 160);
+    if (*volume < 1)
+      *volume = 1;
+    if (origin->x != listener->x || origin->y != listener->y)
+    {
+      angle = R_PointToAngle2(listener->x, listener->y, origin->x, origin->y);
+      if (angle <= listener->angle)
+        angle += 0xffffffff;
+      angle -= listener->angle;
+      angle >>= ANGLETOFINESHIFT;
+      *separation = 128 - (FixedMul(S_STEREO_SWING, finesine[angle]) >> FRACBITS);
+    }
+  }
+  return 1;
+}
+
+static void Evil_NoteSound(mobj_t *origin, mobj_t *listener, int sfx_id)
+{
+  evil_sound_t *e;
+  int volume[MAX_MAXPLAYERS], separation[MAX_MAXPLAYERS], own[MAX_MAXPLAYERS];
+  int i, heard = 0;
+  sfx_id &= ~PICKUP_SOUND;
+  if (sfx_id == sfx_None)
+    return;
+  for (i = 0; i < MAX_MAXPLAYERS; i++)
+  {
+    mobj_t *ears = i == displayplayer ? listener
+                 : playeringame[i] && origin ? players[i].mo
+                 : NULL;
+    if (!Evil_Hear(origin, ears, &volume[i], &separation[i], &own[i]))
+      volume[i] = 0;
+    else
+      heard = 1;
+  }
+  if (!heard)
+    return;
+  e = &evil_sounds[evil_sound_count % EVIL_SOUNDS];
+  e->tic = gametic;
+  e->sfx = sfx_id;
+  e->chasing = 0;
+  if (origin && origin->thinker.function == P_MobjThinker)
+  {
+    e->origin_id = origin->evil_id;
+    e->origin_type = (int)origin->type;
+    // (is the state it's in one of its chase's: the loop from its see state)
+    if (origin->info && origin->info->seestate)
+    {
+      const state_t *first = &states[origin->info->seestate], *st = first;
+      int n = 0;
+      do
+      {
+        if (st == origin->state)
+        {
+          e->chasing = 1;
+          break;
+        }
+        st = &states[st->nextstate];
+      } while (++n < 64 && st != first);
+    }
+  }
+  else
+  {
+    e->origin_id = 0;
+    e->origin_type = -1;
+  }
+  for (i = 0; i < MAX_MAXPLAYERS; i++)
+  {
+    e->own[i] = own[i];
+    e->volume[i] = volume[i];
+    e->separation[i] = separation[i];
+  }
+  e->x = origin ? origin->x >> FRACBITS : listener->x >> FRACBITS;
+  e->y = origin ? origin->y >> FRACBITS : listener->y >> FRACBITS;
+  evil_sound_count++;
+}
