+// Evil (evil-doom): the sounds the game starts, as the listener would hear them, the last
+// EVIL_SOUNDS of them (evil_sound_count in all). Kept whether sound's on or not.
+typedef struct
+{
+  int tic;         // gametic
+  int sfx;         // the sound's number (sfxenum_t)
+  int origin_id;   // the thing it comes from (its evil_id); 0: not a thing (a sector, a line, none)
+  int origin_type; // that thing's type (mobjtype_t); -1: not a thing
+  int own;         // the listener's own (no origin, or the listener itself)
+  int chasing;     // from a thing in its chase (walking) states: a footstep, not an attack
+  int volume;      // 0-127 by its distance (127 within 160, falling to nothing at 1200)
+  int separation;  // 0-255, 128 the middle: which side it's on (never front or back)
+  int x, y;        // where it comes from (map units): the game's, not something heard
+} evil_sound_t;
+#define EVIL_SOUNDS 256
+extern evil_sound_t evil_sounds[EVIL_SOUNDS];
