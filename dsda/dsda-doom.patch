diff --git a/prboom2/src/p_inter.c b/prboom2/src/p_inter.c
index c941fd6..9aaca67 100644
--- a/prboom2/src/p_inter.c
+++ b/prboom2/src/p_inter.c
@@ -1226,7 +1226,41 @@ static dboolean P_InfightingImmune(mobj_t *target, mobj_t *source)
 
 static dboolean P_MorphMonster(mobj_t * actor);
 
+// Evil (evil-doom): every hit on the player kept, what it took and where it came from.
+evil_hit_t evil_hits[EVIL_HITS];
+int evil_hit_count;
+
+static void P_DamageMobjReal(mobj_t *target,mobj_t *inflictor, mobj_t *source, int damage);
+
 void P_DamageMobj(mobj_t *target,mobj_t *inflictor, mobj_t *source, int damage)
+{
+  player_t *player = target->player;
+  int health, armor;
+  if (!player)
+  {
+    P_DamageMobjReal(target, inflictor, source, damage);
+    return;
+  }
+  health = player->health;
+  armor = player->armorpoints[ARMOR_ARMOR];
+  P_DamageMobjReal(target, inflictor, source, damage);
+  if (player->health < health || player->armorpoints[ARMOR_ARMOR] < armor)
+  {
+    evil_hit_t *h = &evil_hits[evil_hit_count % EVIL_HITS];
+    h->health = health - player->health;
+    h->armor = armor - player->armorpoints[ARMOR_ARMOR];
+    h->inflictor = inflictor ? (int)inflictor->type : -1;
+    h->source = source ? (int)source->type : -1;
+    h->self = source == target;
+    h->cause = inflictor || source ? 0
+             : target->ceilingz - target->floorz < target->height ? 1
+             : damage >= 10000 ? 3
+             : 2;
+    evil_hit_count++;
+  }
+}
