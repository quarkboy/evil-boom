# Game data: never commit WADs (the IWADs are commercial; PWADs belong to their authors)
*.wad
*.WAD
*.pk3
*.pk7
wads/

# SoundFonts: your own (soundfonts/README.md); none is redistributable
soundfonts/*
!soundfonts/README.md

# Everything the runs, builds and tests write (logs, score sets, recordings, builds)
out/

# The engine's source, fetched and patched by tools/build-engine.sh
third_party/

# Rust build output (builds normally go to out/build: see docs/BUILDING.md)
native/target/

# Local settings with API keys (config/*.json are the committed defaults)
config/*.local.json

# Python
__pycache__/
*.py[cod]

# Editors, OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
.DS_Store

# git worktrees kept inside the checkout
.worktrees/
.claude/worktrees/
